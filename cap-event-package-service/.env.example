# ---------------------------------------------------------------------------
# cap-event-package-service - copy to `.env` (gitignored) and fill in.
# Placeholders only.
# ---------------------------------------------------------------------------

# Interface/port of the TCP listener. Only the api-gateway connects here; do
# not expose it publicly.
TCP_HOST=127.0.0.1
TCP_PORT=4003

# MongoDB connection string. This service owns the database
# `cap_event_package` (collection: cap_events). REQUIRED.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cap_event_package?appName=<app>

# Where reference-data-service listens (TCP). Used for management-fee journal
# entries and allocation bases; start reference-data-service first.
REFERENCE_DATA_HOST=127.0.0.1
REFERENCE_DATA_PORT=4002
