# ---------------------------------------------------------------------------
# auth-service - copy to `.env` (gitignored) and fill in. Placeholders only.
# ---------------------------------------------------------------------------

# Interface/port of the TCP listener. Only the api-gateway connects here; do
# not expose it publicly. Default host 127.0.0.1 keeps it local-only.
TCP_HOST=127.0.0.1
TCP_PORT=4001

# MongoDB connection string. This service owns the database `cap_event_auth`
# (collections: users, auth_codes, refresh_tokens). REQUIRED.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cap_event_auth?appName=<app>

# HS256 signing key for access/id tokens, at least 32 characters. Must be the
# EXACT same value as api-gateway's PRIVATE_KEY. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PRIVATE_KEY=<long-random-string-at-least-32-chars>

# Token lifetimes in seconds (defaults shown).
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=120

# bcrypt cost factor (default 10).
BCRYPT_ROUNDS=10

# Optional demo user, created on startup if it does not exist yet (idempotent).
# Leave SEED_USER_EMAIL / SEED_USER_PASSWORD empty to disable seeding.
#SEED_USER_EMAIL=<demo-email>
#SEED_USER_PASSWORD=<demo-password-min-8-chars>
#SEED_USER_NAME=Demo User
