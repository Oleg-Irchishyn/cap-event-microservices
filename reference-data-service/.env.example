# ---------------------------------------------------------------------------
# reference-data-service - copy to `.env` (gitignored) and fill in.
# Placeholders only.
# ---------------------------------------------------------------------------

# Interface/port of the TCP listener. The api-gateway and
# cap-event-package-service connect here; do not expose it publicly.
TCP_HOST=127.0.0.1
TCP_PORT=4002

# MongoDB connection string. This service owns the database
# `cap_event_reference_data` (collections: sponsors, fund_groups, entities,
# accounts, mapped_accounts, queries, investments, allocation_bases,
# journal_entries, investor_attributes). The collections are seeded
# idempotently on every startup. REQUIRED.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cap_event_reference_data?appName=<app>
