# ---------------------------------------------------------------------------
# api-gateway - copy to `.env` (gitignored) and fill in. Placeholders only.
# ---------------------------------------------------------------------------

# Public HTTP port (the only public port of the whole system).
PORT=4000

# Public base URL of this gateway, used to build the OIDC `issuer` and the
# discovery document. Default: http://localhost:<PORT>
PUBLIC_URL=http://localhost:4000

# Origin(s) of the Next.js UI allowed by CORS (comma separated). The browser
# calls POST /oidc/2/token and the JSON API from this origin.
CLIENT_URL=http://localhost:3000

# HS256 key used to VERIFY access tokens. REQUIRED, at least 32 characters, and
# must be the EXACT same value as auth-service's PRIVATE_KEY.
PRIVATE_KEY=<long-random-string-at-least-32-chars>

# Where auth-service listens (TCP).
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=4001

# The one OIDC client this fake provider knows. REQUIRED. The UI sends it as
# client_id (NEXT_PUBLIC_ONELOGIN_CLIENT_ID).
CLIENT_ID=cap-event-ui

# Exact-match allow-list of redirect URIs (comma separated). Post-logout
# redirects must be on one of these origins (or CLIENT_URL's).
ALLOWED_REDIRECT_URIS=http://localhost:3000/cap-event/auth/callback
