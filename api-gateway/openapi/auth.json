{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/registration": {
      "post": {
        "operationId": "AuthController_registration",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "User with this email already exists"
          }
        },
        "summary": "Register a user and log in (auth.register + auth.login)",
        "tags": [
          "Authorization"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "summary": "Log in with email and password (auth.login)",
        "tags": [
          "Authorization"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "User is not authorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get the currently authenticated user (auth.me)",
        "tags": [
          "Authorization"
        ]
      }
    },
    "/oidc/2/.well-known/openid-configuration": {
      "get": {
        "operationId": "OidcController_discovery",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryDocumentDto"
                }
              }
            }
          }
        },
        "summary": "OpenID Connect discovery document",
        "tags": [
          "OIDC (fake OneLogin)"
        ]
      }
    },
    "/oidc/2/auth": {
      "get": {
        "description": "Returns text/html (not JSON). Add `mode=register` to show the registration form. An unknown client_id or unregistered redirect_uri renders an error page (400) and never redirects.",
        "operationId": "OidcController_showForm",
        "parameters": [
          {
            "name": "mode",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "login",
                "register"
              ],
              "type": "string"
            }
          },
          {
            "name": "prompt",
            "required": false,
            "in": "query",
            "schema": {
              "example": "login"
            }
          },
          {
            "name": "nonce",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "resource",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "state",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "scope",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "code_challenge_method",
            "required": true,
            "in": "query",
            "schema": {
              "example": "S256"
            }
          },
          {
            "name": "code_challenge",
            "required": true,
            "in": "query",
            "schema": {}
          },
          {
            "name": "response_type",
            "required": true,
            "in": "query",
            "schema": {
              "example": "code"
            }
          },
          {
            "name": "redirect_uri",
            "required": true,
            "in": "query",
            "schema": {}
          },
          {
            "name": "client_id",
            "required": true,
            "in": "query",
            "schema": {
              "example": "cap-event-ui"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML form",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to redirect_uri with error=... for non-fatal request errors"
          },
          "400": {
            "description": "HTML error page",
            "content": {
              "text/html": {}
            }
          }
        },
        "summary": "Authorization endpoint - renders the HTML sign-in / register form",
        "tags": [
          "OIDC (fake OneLogin)"
        ]
      },
      "post": {
        "description": "On success issues a one-time authorization code (2 min TTL, bound to client, redirect_uri and PKCE challenge) and answers 302 to `redirect_uri?code=...&state=...`. On bad credentials re-renders the HTML form (401) with an error.",
        "operationId": "OidcController_submitForm",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeFormDto"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to redirect_uri with code and state"
          },
          "400": {
            "description": "HTML form with validation error",
            "content": {
              "text/html": {}
            }
          },
          "401": {
            "description": "HTML form with \"Invalid email or password\"",
            "content": {
              "text/html": {}
            }
          },
          "409": {
            "description": "HTML form: email already registered",
            "content": {
              "text/html": {}
            }
          }
        },
        "summary": "Submit the sign-in / register form",
        "tags": [
          "OIDC (fake OneLogin)"
        ]
      }
    },
    "/oidc/2/token": {
      "post": {
        "description": "Called from the browser with fetch (CORS allows CLIENT_URL). The code is single use; refresh tokens rotate on every use. Errors follow RFC 6749: `{ error, error_description }`.",
        "operationId": "OidcController_token",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request, invalid_grant, unsupported_grant_type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "invalid_client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthErrorDto"
                }
              }
            }
          }
        },
        "summary": "Token endpoint - authorization_code (PKCE) and refresh_token grants",
        "tags": [
          "OIDC (fake OneLogin)"
        ]
      }
    },
    "/oidc/2/logout": {
      "get": {
        "description": "Revokes every refresh token of the user named by `id_token_hint`, then answers 302 to `post_logout_redirect_uri` (must be on an allowed origin). Without a redirect, renders a \"signed out\" HTML page.",
        "operationId": "OidcController_logout",
        "parameters": [
          {
            "name": "state",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "post_logout_redirect_uri",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "id_token_hint",
            "required": false,
            "in": "query",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "HTML \"signed out\" page",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to post_logout_redirect_uri"
          },
          "400": {
            "description": "HTML error page: unregistered post_logout_redirect_uri",
            "content": {
              "text/html": {}
            }
          }
        },
        "summary": "End-session endpoint - revokes the user's refresh tokens and redirects",
        "tags": [
          "OIDC (fake OneLogin)"
        ]
      }
    }
  },
  "info": {
    "title": "cap-event API Gateway",
    "description": "Public HTTP surface for cap-event: a fake OneLogin (OIDC, Authorization Code + PKCE) a spotify-style JSON auth API, and the reference-data / cap-event-package routes the UI calls (derived from the OpenAPI specs in contracts/openapi). This document is the contract for the UI.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@example.com",
            "description": "Email (login)"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery",
            "description": "Password, 8-72 characters",
            "minLength": 8,
            "maxLength": 72
          },
          "name": {
            "type": "string",
            "example": "Demo User",
            "description": "Display name"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "665f1c2e9b1e8a0012345678"
          },
          "email": {
            "type": "string",
            "example": "demo@example.com"
          },
          "name": {
            "type": "string",
            "example": "Demo User"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "HS256 JWT with sub, email, name claims"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "number",
            "example": 3600,
            "description": "Access token lifetime in seconds"
          },
          "refresh_token": {
            "type": "string",
            "description": "Opaque, single-use; rotated on every refresh"
          },
          "id_token": {
            "type": "string",
            "description": "HS256 JWT with sub, email, name, aud, iss"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "id_token",
          "user"
        ]
      },
      "ValidationErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "example": [
              "email - Should be a valid email address"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@example.com",
            "description": "Email (login)"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery",
            "description": "Password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "DiscoveryDocumentDto": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "example": "http://localhost:4000/oidc/2"
          },
          "authorization_endpoint": {
            "type": "string"
          },
          "token_endpoint": {
            "type": "string"
          },
          "end_session_endpoint": {
            "type": "string"
          },
          "response_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id_token_signing_alg_values_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "token_endpoint_auth_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code_challenge_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claims_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issuer",
          "authorization_endpoint",
          "token_endpoint",
          "end_session_endpoint",
          "response_types_supported",
          "grant_types_supported",
          "subject_types_supported",
          "id_token_signing_alg_values_supported",
          "scopes_supported",
          "token_endpoint_auth_methods_supported",
          "code_challenge_methods_supported",
          "claims_supported"
        ]
      },
      "AuthorizeFormDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "login",
              "register"
            ],
            "default": "login"
          },
          "email": {
            "type": "string",
            "example": "demo@example.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "name": {
            "type": "string",
            "description": "Required when mode=register"
          },
          "client_id": {
            "type": "string",
            "example": "cap-event-ui"
          },
          "redirect_uri": {
            "type": "string",
            "example": "http://localhost:3000/cap-event/auth/callback"
          },
          "response_type": {
            "type": "string",
            "example": "code"
          },
          "scope": {
            "type": "string",
            "example": "openid profile email"
          },
          "state": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "code_challenge": {
            "type": "string",
            "description": "base64url(SHA-256(code_verifier))"
          },
          "code_challenge_method": {
            "type": "string",
            "enum": [
              "S256"
            ]
          },
          "nonce": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "mode",
          "email",
          "password",
          "client_id",
          "redirect_uri",
          "response_type",
          "code_challenge",
          "code_challenge_method"
        ]
      },
      "TokenRequestDto": {
        "type": "object",
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "authorization_code",
              "refresh_token"
            ],
            "example": "authorization_code"
          },
          "client_id": {
            "type": "string",
            "example": "cap-event-ui",
            "description": "Must equal CLIENT_ID"
          },
          "code": {
            "type": "string",
            "description": "authorization_code grant: the one-time code"
          },
          "redirect_uri": {
            "type": "string",
            "description": "authorization_code grant: must equal the redirect_uri of the auth request"
          },
          "code_verifier": {
            "type": "string",
            "description": "authorization_code grant: PKCE verifier"
          },
          "refresh_token": {
            "type": "string",
            "description": "refresh_token grant: the current refresh token"
          }
        },
        "required": [
          "grant_type",
          "client_id"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "HS256 JWT with sub, email, name claims"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "number",
            "example": 3600,
            "description": "Access token lifetime in seconds"
          },
          "refresh_token": {
            "type": "string",
            "description": "Opaque, single-use; rotated on every refresh"
          },
          "id_token": {
            "type": "string",
            "description": "HS256 JWT with sub, email, name, aud, iss"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "id_token"
        ]
      },
      "OAuthErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "invalid_grant",
            "description": "OAuth2 error code"
          },
          "error_description": {
            "type": "string",
            "example": "Authorization code is invalid or expired",
            "description": "Human-readable explanation"
          }
        },
        "required": [
          "error",
          "error_description"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "batchNo"
          },
          "reason": {
            "type": "string",
            "example": "INVALID_VALUE"
          },
          "message": {
            "type": "string",
            "example": "Should be an integer"
          }
        }
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "RESOURCE_NOT_FOUND",
              "INTERNAL_SERVER_ERROR",
              "CONFLICT",
              "FORBIDDEN",
              "ACCESS_DENIED",
              "BAD_REQUEST"
            ],
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "timestamp": {
            "type": "string",
            "example": "2026-11-05T10:15:30.123Z"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "example": "9b173b09-7a85-4c58-b127-7e8a9a564400"
          }
        }
      },
      "FundGroupDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "FG001"
          },
          "name": {
            "type": "string",
            "example": "Global Equity"
          }
        }
      },
      "AllocationBasisDto": {
        "type": "object",
        "properties": {
          "allocationId": {
            "type": "string",
            "example": "DS-CMNT"
          },
          "allocationName": {
            "type": "string",
            "example": "Commitment"
          },
          "type": {
            "type": "string",
            "example": "dynamic"
          },
          "allocationBasisStatus": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ]
          }
        }
      },
      "EntityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "73301-01"
          },
          "name": {
            "type": "string",
            "example": "Global Equity Master Fund LP"
          },
          "dueDateDays": {
            "type": "string",
            "example": "10"
          },
          "dueDateType": {
            "type": "string",
            "example": "Business Days"
          },
          "mfBasis": {
            "type": "string",
            "deprecated": true
          },
          "allocationBasis": {
            "$ref": "#/components/schemas/AllocationBasisDto"
          },
          "allocationBasisPostInvPeriod": {
            "$ref": "#/components/schemas/AllocationBasisDto"
          },
          "mfBasisDateDefault": {
            "type": "string",
            "example": "Quarter End"
          },
          "yearFractionApproach": {
            "type": "string",
            "example": "ACT/360"
          },
          "mfPercent": {
            "type": "string",
            "example": "0.02"
          },
          "mfStartDate": {
            "type": "string",
            "example": "01/01/2025"
          },
          "mfStepDownDate": {
            "type": "string",
            "example": "01/01/2029"
          },
          "mfPercentPostInvPeriod": {
            "type": "string",
            "example": "0.015"
          }
        }
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "accountKey": {
            "type": "string",
            "example": "1-3110"
          },
          "accountName": {
            "type": "string",
            "example": "Partners Capital - Contributions"
          },
          "accountNo": {
            "type": "string",
            "example": "3110"
          },
          "capitalCategory": {
            "type": "string",
            "example": "Cont - Investments"
          },
          "callDistributionReason": {
            "type": "string",
            "example": "Investment"
          },
          "defaultDescription": {
            "type": "string",
            "example": "Capital call for investment"
          },
          "insideCommitment": {
            "type": "string",
            "example": "Yes"
          },
          "fsLineItem": {
            "type": "string",
            "example": "Partners' Capital"
          }
        }
      },
      "QueryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "InvestmentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the investment"
          },
